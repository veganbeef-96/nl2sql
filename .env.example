# NL2SQL_PROVIDER: which LLM provider to use — "openai" or "anthropic" (default: openai)
NL2SQL_PROVIDER=openai

# --- OpenAI provider ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
NL2SQL_MODEL=

# --- Anthropic provider ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- Database & safety ---
NL2SQL_DB_PATH=
NL2SQL_MASK_SENSITIVE=true